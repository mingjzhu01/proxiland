{
  "expo": {
    "name": "Proxiland",
    "slug": "proxiland",
    "version": "1.2.0",
    "scheme": "proxiland",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "bundleIdentifier": "com.mingjzhu.proxiland",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Proxiland uses your location, only while the app is open and only when you turn on visibility, to show you nearby professionals and let them see you.",
        "NSPhotoLibraryUsageDescription": "Proxiland needs access to your photos so you can set a profile picture.",
        "NSCameraUsageDescription": "Proxiland needs camera access so you can take a profile picture and scan event QR codes."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#3b5bdb"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "resizeMode": "cover",
          "backgroundColor": "#4A3B31"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Proxiland needs camera access so you can take a profile picture and scan event QR codes.",
          "microphonePermission": "Proxiland does not use your microphone.",
          "recordAudioAndroid": false
        }
      ],
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d792fc2e-52ba-4e37-9f5b-636200e20ff4"
      }
    },
    "owner": "mingjzhu",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d792fc2e-52ba-4e37-9f5b-636200e20ff4"
    }
  }
}
